<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-900 text-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HoopMap - Red de Canchas y Jugadores de Baloncesto</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Google Fonts: Inter & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@700;800;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Outfit', 'sans-serif'],
          },
          colors: {
            hoop: {
              orange: '#f97316',
              darkorange: '#ea580c',
              accent: '#38bdf8',
              card: '#1e293b',
              border: '#334155'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #f97316;
    }
    .leaflet-popup-content-wrapper, .leaflet-popup-tip {
      background-color: #1e293b !important;
      color: #f8fafc !important;
      border: 1px solid #334155;
      border-radius: 0.75rem !important;
    }
    .leaflet-container {
      background-color: #0f172a !important;
    }
  </style>
</head>
<body class="h-full flex flex-col font-sans bg-slate-950 text-slate-100 antialiased overflow-x-hidden">

  <!-- Top Navigation Header -->
  <header class="sticky top-0 z-40 w-full border-b border-slate-800 bg-slate-900/90 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Logo -->
      <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('courts')">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-600 to-amber-500 flex items-center justify-center shadow-lg shadow-orange-500/20">
          <i class="fa-solid font-black fa-basketball text-2xl text-white"></i>
        </div>
        <span class="font-display font-extrabold text-2xl tracking-tight bg-gradient-to-r from-orange-400 via-amber-300 to-amber-500 bg-clip-text text-transparent">
          HoopMap
        </span>
      </div>

      <!-- Desktop Nav Items -->
      <nav class="hidden md:flex items-center space-x-2">
        <button onclick="switchTab('courts')" id="nav-courts" class="px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 bg-orange-500/10 text-orange-400 border border-orange-500/20">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>Canchas</span>
        </button>
        <button onclick="switchTab('community')" id="nav-community" class="px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-100 hover:bg-slate-800">
          <i class="fa-solid fa-users"></i>
          <span>Jugadores Reales</span>
        </button>
        <button onclick="switchTab('add-court')" id="nav-add-court" class="px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-100 hover:bg-slate-800">
          <i class="fa-solid fa-plus-circle"></i>
          <span>Agregar Cancha</span>
        </button>
      </nav>

      <!-- User Auth Section Top Right -->
      <div class="flex items-center space-x-3">
        <div id="user-header-profile" class="hidden flex items-center space-x-3 bg-slate-800/80 p-1.5 pr-4 rounded-full border border-slate-700/60">
          <img id="user-header-avatar" src="https://placehold.co/100x100/f97316/ffffff?text=HM" class="w-8 h-8 rounded-full object-cover border border-orange-500" alt="Avatar">
          <span id="user-header-name" class="text-sm font-medium text-slate-200 max-w-[120px] truncate">Usuario</span>
          <button onclick="openProfileModal()" class="text-slate-400 hover:text-orange-400 text-xs pl-1">
            <i class="fa-solid fa-gear"></i>
          </button>
          <button onclick="handleLogout()" class="text-rose-400 hover:text-rose-300 text-xs pl-1" title="Cerrar Sesión">
            <i class="fa-solid fa-right-from-bracket"></i>
          </button>
        </div>

        <button id="btn-login-header" onclick="openAuthModal('login')" class="px-4 py-2 rounded-xl text-sm font-semibold bg-gradient-to-r from-orange-500 to-amber-500 text-white shadow-md hover:opacity-90 transition">
          <i class="fa-solid fa-user-check mr-1.5"></i> Iniciar Sesión
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Body -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 flex flex-col">

    <!-- Tab 1: Courts & Map View -->
    <section id="tab-courts" class="flex-1 flex flex-col space-y-6">
      <!-- Search & Filters -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col md:flex-row gap-4 justify-between items-center shadow-lg">
        <div class="relative w-full md:w-96">
          <i class="fa-solid fa-search absolute left-4 top-3.5 text-slate-500 text-sm"></i>
          <input type="text" id="court-search-input" onkeyup="filterCourts()" placeholder="Buscar canchas por nombre o ciudad..." class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-11 pr-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500 transition">
        </div>
        <div class="flex items-center space-x-2 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
          <button onclick="filterType('all')" class="filter-btn active-filter px-3.5 py-2 rounded-xl text-xs font-semibold bg-orange-500 text-white whitespace-nowrap">Todas</button>
          <button onclick="filterType('Techada')" class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 whitespace-nowrap">Techadas</button>
          <button onclick="filterType('Aire Libre')" class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 whitespace-nowrap">Aire Libre</button>
          <button onclick="filterType('Malla de Metal')" class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 whitespace-nowrap">Con Malla</button>
        </div>
      </div>

      <!-- Main Split View: Map + Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1 min-h-[550px]">
        
        <!-- Interactive Map Container -->
        <div class="lg:col-span-7 bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-xl flex flex-col relative h-[380px] lg:h-auto min-h-[350px]">
          <div id="map" class="w-full h-full z-10"></div>
          <div class="absolute bottom-3 left-3 z-20 bg-slate-900/90 backdrop-blur border border-slate-700/60 rounded-xl px-3 py-1.5 text-xs text-slate-300 flex items-center space-x-2">
            <span class="w-2.5 h-2.5 rounded-full bg-orange-500 animate-pulse"></span>
            <span>Haz clic en un marcador para ver la cancha</span>
          </div>
        </div>

        <!-- Court Cards List -->
        <div class="lg:col-span-5 flex flex-col space-y-4 overflow-y-auto max-h-[600px] pr-1" id="courts-list-container">
          <!-- Dynamically populated -->
        </div>
      </div>
    </section>

    <!-- Tab 2: Community & Real Players -->
    <section id="tab-community" class="hidden flex-1 flex-col space-y-6">
      <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <h2 class="text-2xl font-display font-extrabold text-white flex items-center space-x-3">
          <i class="fa-solid fa-users text-orange-500"></i>
          <span>Jugadores Reales Registrados</span>
        </h2>
        <p class="text-slate-400 text-sm mt-1">Conecta con baloncestistas reales de tu comunidad para organizar retias o juegos 3x3 y 5x5.</p>
      </div>

      <div id="community-users-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Dynamically rendered -->
      </div>
    </section>

    <!-- Tab 3: Add New Court -->
    <section id="tab-add-court" class="hidden flex-1 flex flex-col justify-center max-w-2xl mx-auto w-full">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
        <div>
          <h2 class="text-2xl font-display font-extrabold text-white flex items-center space-x-2">
            <i class="fa-solid fa-map-pin text-orange-500"></i>
            <span>Agregar Nueva Cancha Real</span>
          </h2>
          <p class="text-slate-400 text-sm mt-1">Aporta a la comunidad registrando una cancha pública o privada disponible.</p>
        </div>

        <form id="add-court-form" onsubmit="handleCreateCourt(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Nombre de la Cancha</label>
            <input type="text" id="new-court-name" required placeholder="Ej. Cancha Parque Central" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Ciudad / Sector</label>
              <input type="text" id="new-court-city" required placeholder="Ej. Caracas, Chacao" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Tipo de Cancha</label>
              <select id="new-court-type" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
                <option value="Aire Libre">Aire Libre</option>
                <option value="Techada">Techada</option>
                <option value="Gimnasio Cerrado">Gimnasio Cerrado</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Latitud GPS</label>
              <input type="number" step="any" id="new-court-lat" required placeholder="Ej. 10.4806" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Longitud GPS</label>
              <input type="number" step="any" id="new-court-lng" required placeholder="Ej. -66.9036" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Estado de Mallas y Tableros</label>
            <input type="text" id="new-court-condition" placeholder="Ej. Tableros de vidrio, mallas de nailon en buen estado" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
          </div>

          <div class="pt-2">
            <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 text-white font-semibold text-sm shadow-lg hover:opacity-90 transition">
              <i class="fa-solid fa-plus mr-1"></i> Publicar Cancha en el Mapa
            </button>
          </div>
        </form>
      </div>
    </section>

  </main>


  <!-- Modal 1: Court Live Chat Drawer/Modal -->
  <div id="modal-court-chat" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-2 sm:p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl h-[90vh] flex flex-col overflow-hidden shadow-2xl animate-in fade-in zoom-in duration-200">
      
      <!-- Chat Header -->
      <div class="p-4 border-b border-slate-800 bg-slate-900/90 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400">
            <i class="fa-solid fa-comments text-lg"></i>
          </div>
          <div>
            <h3 id="chat-court-title" class="font-display font-bold text-slate-100 text-base sm:text-lg line-clamp-1">Nombre de la Cancha</h3>
            <p id="chat-court-subtitle" class="text-xs text-slate-400">Comunidad y Retias en Vivo</p>
          </div>
        </div>
        <button onclick="closeChatModal()" class="w-8 h-8 rounded-full bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Chat Messages Scroll Container -->
      <div id="chat-messages-box" class="flex-1 p-4 overflow-y-auto space-y-4 bg-slate-950/60">
        <!-- Messages loaded here -->
      </div>

      <!-- Chat Input Field -->
      <div class="p-4 border-t border-slate-800 bg-slate-900">
        <div id="chat-input-area" class="flex items-center space-x-2">
          <input type="text" id="chat-message-input" onkeypress="handleChatKeyPress(event)" placeholder="Escribe un mensaje para los jugadores de esta cancha..." class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
          <button onclick="sendChatMessage()" class="w-11 h-11 rounded-xl bg-orange-500 hover:bg-orange-600 text-white flex items-center justify-center transition shadow-lg">
            <i class="fa-solid fa-paper-plane"></i>
          </button>
        </div>
        <p id="chat-login-prompt" class="hidden text-xs text-center text-amber-400 py-2">
          Debes <button onclick="closeChatModal(); openAuthModal('login');" class="underline font-bold">Iniciar Sesión</button> para enviar mensajes reales a esta cancha.
        </p>
      </div>
    </div>
  </div>

  <!-- Modal 2: User Authentication (Login / Register) -->
  <div id="modal-auth" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 sm:p-8 shadow-2xl relative">
      <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-sm">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>

      <!-- Toggle Tabs Login/Register -->
      <div class="flex border-b border-slate-800 mb-6">
        <button id="tab-btn-login" onclick="switchAuthTab('login')" class="flex-1 pb-3 text-sm font-bold border-b-2 border-orange-500 text-orange-400">
          Iniciar Sesión
        </button>
        <button id="tab-btn-register" onclick="switchAuthTab('register')" class="flex-1 pb-3 text-sm font-bold border-b-2 border-transparent text-slate-400 hover:text-slate-200">
          Crear Cuenta Real
        </button>
      </div>

      <!-- Login Form -->
      <form id="form-login" onsubmit="handleAuthLogin(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Correo Electrónico</label>
          <input type="email" id="login-email" required placeholder="tu@email.com" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Contraseña</label>
          <input type="password" idlogin-password" id="login-password" required placeholder="••••••••" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 text-white font-semibold text-sm shadow-lg hover:opacity-90 transition mt-2">
          Entrar a HoopMap
        </button>
      </form>

      <!-- Register Form -->
      <form id="form-register" onsubmit="handleAuthRegister(event)" class="hidden space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Nombre Completo</label>
          <input type="text" id="reg-name" required placeholder="Ej. Carlos Mendoza" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Nombre de Usuario (@)</label>
          <input type="text" id="reg-username" required placeholder="carlos3x3" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Posición Principal</label>
            <select id="reg-position" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
              <option value="Base (PG)">Base (PG)</option>
              <option value="Escolta (SG)">Escolta (SG)</option>
              <option value="Alero (SF)">Alero (SF)</option>
              <option value="Ala-Pívot (PF)">Ala-Pívot (PF)</option>
              <option value="Pívot (C)">Pívot (C)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Nivel</label>
            <select id="reg-level" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
              <option value="Recreativo">Recreativo</option>
              <option value="Intermedio">Intermedio</option>
              <option value="Competitivo">Competitivo</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Correo Electrónico</label>
          <input type="email" id="reg-email" required placeholder="tu@email.com" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Contraseña</label>
          <input type="password" id="reg-password" required placeholder="Mínimo 6 caracteres" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-orange-500">
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 text-white font-semibold text-sm shadow-lg hover:opacity-90 transition mt-2">
          Registrar mi Perfil
        </button>
      </form>
    </div>
  </div>

  <script>
    /* ==========================================================================
       APP STATE & LOCAL PERSISTENCE
       ========================================================================== */
    let currentUser = null;
    let activeTab = 'courts';
    let map = null;
    let mapMarkers = [];
    let currentChatCourtId = null;

    // Initial Real Courts Data
    let courtsData = [
      {
        id: "court-1",
        name: "Cancha Parque Miranda",
        city: "Caracas, Sebucán",
        type: "Techada",
        lat: 10.4932,
        lng: -66.8378,
        condition: "Tableros profesionales de acrílico y mallas de nailon",
        rating: 4.8,
        activePlayersToday: 12
      },
      {
        id: "court-2",
        name: "Cancha Los Palos Grandes",
        city: "Caracas, Chacao",
        type: "Aire Libre",
        lat: 10.4975,
        lng: -66.8450,
        condition: "Aros reglamentarios y buena iluminación nocturna",
        rating: 4.5,
        activePlayersToday: 8
      },
      {
        id: "court-3",
        name: "Cancha Polideportivo El Hatillo",
        city: "Caracas, El Hatillo",
        type: "Malla de Metal",
        lat: 10.4281,
        lng: -66.8247,
        condition: "Piso pintado reciente, techada con gradas",
        rating: 4.9,
        activePlayersToday: 15
      }
    ];

    // Real Registered Users Store
    let registeredUsers = [];

    // Real Court Messages Store indexed by court ID
    let courtChatMessages = {};

    /* ==========================================================================
       INITIALIZATION
       ========================================================================== */
    window.onload = function() {
      loadStoredData();
      initMap();
      renderCourtsList(courtsData);
      renderCommunity();
      checkSavedSession();
    };

    function loadStoredData() {
      // Load saved courts from storage if any
      const savedCourts = localStorage.getItem('hoopmap_courts');
      if (savedCourts) {
        try { courtsData = JSON.parse(savedCourts); } catch(e){}
      }

      // Load real users
      const savedUsers = localStorage.getItem('hoopmap_users');
      if (savedUsers) {
        try { registeredUsers = JSON.parse(savedUsers); } catch(e){}
      }

      // Load chats
      const savedChats = localStorage.getItem('hoopmap_chats');
      if (savedChats) {
        try { courtChatMessages = JSON.parse(savedChats); } catch(e){}
      }
    }

    function saveStateToStorage() {
      localStorage.setItem('hoopmap_courts', JSON.stringify(courtsData));
      localStorage.setItem('hoopmap_users', JSON.stringify(registeredUsers));
      localStorage.setItem('hoopmap_chats', JSON.stringify(courtChatMessages));
    }

    /* ==========================================================================
       NAVIGATION & TABS
       ========================================================================== */
    function switchTab(tabName) {
      activeTab = tabName;
      document.getElementById('tab-courts').classList.add('hidden');
      document.getElementById('tab-community').classList.add('hidden');
      document.getElementById('tab-add-court').classList.add('hidden');

      document.getElementById('nav-courts').className = "px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-100 hover:bg-slate-800";
      document.getElementById('nav-community').className = "px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-100 hover:bg-slate-800";
      document.getElementById('nav-add-court').className = "px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-100 hover:bg-slate-800";

      if (tabName === 'courts') {
        document.getElementById('tab-courts').classList.remove('hidden');
        document.getElementById('nav-courts').className = "px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 bg-orange-500/10 text-orange-400 border border-orange-500/20";
        setTimeout(() => { if (map) map.invalidateSize(); }, 200);
      } else if (tabName === 'community') {
        document.getElementById('tab-community').classList.remove('hidden');
        document.getElementById('nav-community').className = "px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 bg-orange-500/10 text-orange-400 border border-orange-500/20";
      } else if (tabName === 'add-court') {
        document.getElementById('tab-add-court').classList.remove('hidden');
        document.getElementById('nav-add-court').className = "px-4 py-2 rounded-xl text-sm font-semibold transition-all flex items-center space-x-2 bg-orange-500/10 text-orange-400 border border-orange-500/20";
      }
    }

    /* ==========================================================================
       LEAFLET MAP INTEGRATION
       ========================================================================== */
    function initMap() {
      // Default centered on Caracas coordinates
      map = L.map('map').setView([10.4806, -66.9036], 12);

      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
        maxZoom: 19
      }).addTo(map);

      updateMapMarkers(courtsData);
    }

    function updateMapMarkers(courts) {
      if (!map) return;
      
      // Clear old markers
      mapMarkers.forEach(m => map.removeLayer(m));
      mapMarkers = [];

      courts.forEach(court => {
        const customIcon = L.divIcon({
          className: 'custom-div-icon',
          html: `<div class="w-8 h-8 rounded-full bg-gradient-to-tr from-orange-600 to-amber-500 border-2 border-white flex items-center justify-center text-white shadow-lg cursor-pointer transform hover:scale-110 transition">
                  <i class="fa-solid fa-basketball text-xs"></i>
                 </div>`,
          iconSize: [32, 32],
          iconAnchor: [16, 16]
        });

        const marker = L.marker([court.lat, court.lng], { icon: customIcon }).addTo(map);
        marker.bindPopup(`
          <div class="p-1 space-y-2">
            <h4 class="font-bold text-sm text-slate-100">${court.name}</h4>
            <p class="text-xs text-slate-400"><i class="fa-solid fa-location-dot text-orange-400 mr-1"></i>${court.city}</p>
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-orange-500/20 text-orange-400 border border-orange-500/30">${court.type}</span>
            <button onclick="openCourtChat('${court.id}')" class="w-full mt-2 py-1.5 rounded-lg bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold transition">
              Entrar al Chat
            </button>
          </div>
        `);

        mapMarkers.push(marker);
      });
    }

    /* ==========================================================================
       COURT RENDERING & FILTERS
       ========================================================================== */
    function renderCourtsList(courts) {
      const container = document.getElementById('courts-list-container');
      container.innerHTML = '';

      if (courts.length === 0) {
        container.innerHTML = `
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center text-slate-400">
            <i class="fa-solid fa-circle-exclamation text-3xl mb-2 text-slate-600"></i>
            <p>No se encontraron canchas con esos filtros.</p>
          </div>
        `;
        return;
      }

      courts.forEach(court => {
        const card = document.createElement('div');
        card.className = "bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl p-4 sm:p-5 transition shadow-lg flex flex-col justify-between space-y-4 group";
        card.innerHTML = `
          <div class="flex items-start justify-between">
            <div class="space-y-1">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-orange-500/10 text-orange-400 border border-orange-500/20">
                ${court.type}
              </span>
              <h3 class="font-display font-bold text-slate-100 text-lg group-hover:text-orange-400 transition">${court.name}</h3>
              <p class="text-xs text-slate-400 flex items-center">
                <i class="fa-solid fa-location-dot text-slate-500 mr-1.5"></i> ${court.city}
              </p>
            </div>
            <div class="flex items-center space-x-1 bg-amber-500/10 text-amber-400 px-2.5 py-1 rounded-lg text-xs font-bold border border-amber-500/20">
              <i class="fa-solid fa-star text-amber-400"></i>
              <span>${court.rating}</span>
            </div>
          </div>

          <p class="text-xs text-slate-400 bg-slate-950/60 p-2.5 rounded-xl border border-slate-800/80">
            <i class="fa-solid fa-info-circle text-orange-400 mr-1"></i> ${court.condition}
          </p>

          <div class="flex items-center justify-between pt-1 border-t border-slate-800/80">
            <span class="text-xs text-slate-400 flex items-center">
              <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
              ${court.activePlayersToday} en retia hoy
            </span>
            <button onclick="openCourtChat('${court.id}')" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-orange-500 hover:text-white text-slate-200 text-xs font-bold transition flex items-center space-x-1.5">
              <i class="fa-solid fa-comments"></i>
              <span>Abrir Chat</span>
            </button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function filterCourts() {
      const query = document.getElementById('court-search-input').value.toLowerCase();
      const filtered = courtsData.filter(c => 
        c.name.toLowerCase().includes(query) || c.city.toLowerCase().includes(query)
      );
      renderCourtsList(filtered);
      updateMapMarkers(filtered);
    }

    function filterType(type) {
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('bg-orange-500', 'text-white');
        btn.classList.add('bg-slate-800', 'text-slate-300');
      });
      event.target.classList.remove('bg-slate-800', 'text-slate-300');
      event.target.classList.add('bg-orange-500', 'text-white');

      if (type === 'all') {
        renderCourtsList(courtsData);
        updateMapMarkers(courtsData);
      } else {
        const filtered = courtsData.filter(c => c.type.toLowerCase().includes(type.toLowerCase()));
        renderCourtsList(filtered);
        updateMapMarkers(filtered);
      }
    }

    /* ==========================================================================
       COMMUNITY & USERS
       ========================================================================== */
    function renderCommunity() {
      const grid = document.getElementById('community-users-grid');
      grid.innerHTML = '';

      if (registeredUsers.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center text-slate-400">
            <i class="fa-solid fa-user-plus text-4xl mb-3 text-slate-600"></i>
            <h3 class="font-bold text-slate-200 text-base mb-1">Aún no hay otros jugadores registrados</h3>
            <p class="text-xs">¡Sé el primero en registrarte con tu perfil real en HoopMap!</p>
          </div>
        `;
        return;
      }

      registeredUsers.forEach(u => {
        const card = document.createElement('div');
        card.className = "bg-slate-900 border border-slate-800 rounded-2xl p-5 flex items-center space-x-4 shadow-lg";
        card.innerHTML = `
          <div class="relative">
            <img src="${u.avatar || 'https://placehold.co/100x100/f97316/ffffff?text=' + u.name.charAt(0)}" class="w-14 h-14 rounded-full object-cover border-2 border-orange-500" alt="Avatar">
            <span class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-slate-900"></span>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="font-bold text-slate-100 text-sm truncate">${u.name}</h4>
            <p class="text-xs text-orange-400 font-semibold">@${u.username}</p>
            <div class="flex items-center space-x-2 mt-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700">${u.position}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">${u.level}</span>
            </div>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    /* ==========================================================================
       AUTHENTICATION & USER SESSION
       ========================================================================== */
    function openAuthModal(mode) {
      document.getElementById('modal-auth').classList.remove('hidden');
      switchAuthTab(mode);
    }

    function closeAuthModal() {
      document.getElementById('modal-auth').classList.add('hidden');
    }

    function switchAuthTab(tab) {
      if (tab === 'login') {
        document.getElementById('form-login').classList.remove('hidden');
        document.getElementById('form-register').classList.add('hidden');
        document.getElementById('tab-btn-login').className = "flex-1 pb-3 text-sm font-bold border-b-2 border-orange-500 text-orange-400";
        document.getElementById('tab-btn-register').className = "flex-1 pb-3 text-sm font-bold border-b-2 border-transparent text-slate-400 hover:text-slate-200";
      } else {
        document.getElementById('form-login').classList.add('hidden');
        document.getElementById('form-register').classList.remove('hidden');
        document.getElementById('tab-btn-register').className = "flex-1 pb-3 text-sm font-bold border-b-2 border-orange-500 text-orange-400";
        document.getElementById('tab-btn-login').className = "flex-1 pb-3 text-sm font-bold border-b-2 border-transparent text-slate-400 hover:text-slate-200";
      }
    }

    function handleAuthRegister(e) {
      e.preventDefault();
      const name = document.getElementById('reg-name').value;
      const username = document.getElementById('reg-username').value;
      const position = document.getElementById('reg-position').value;
      const level = document.getElementById('reg-level').value;
      const email = document.getElementById('reg-email').value;

      const newUser = {
        id: 'usr_' + Date.now(),
        name: name,
        username: username,
        position: position,
        level: level,
        email: email,
        avatar: `https://placehold.co/100x100/ea580c/ffffff?text=${name.charAt(0).toUpperCase()}`
      };

      registeredUsers.unshift(newUser);
      currentUser = newUser;

      localStorage.setItem('hoopmap_current_session', JSON.stringify(currentUser));
      saveStateToStorage();

      updateUserUI();
      renderCommunity();
      closeAuthModal();
      alert(`¡Bienvenido a HoopMap, ${name}! Tu perfil ha sido creado.`);
    }

    function handleAuthLogin(e) {
      e.preventDefault();
      const email = document.getElementById('login-email').value;
      
      const found = registeredUsers.find(u => u.email.toLowerCase() === email.toLowerCase());

      if (found) {
        currentUser = found;
      } else {
        // Create quick profile if first time entering email
        currentUser = {
          id: 'usr_' + Date.now(),
          name: email.split('@')[0],
          username: email.split('@')[0],
          position: 'Base (PG)',
          level: 'Intermedio',
          email: email,
          avatar: `https://placehold.co/100x100/f97316/ffffff?text=${email.charAt(0).toUpperCase()}`
        };
        registeredUsers.unshift(currentUser);
        saveStateToStorage();
      }

      localStorage.setItem('hoopmap_current_session', JSON.stringify(currentUser));
      updateUserUI();
      renderCommunity();
      closeAuthModal();
    }

    function checkSavedSession() {
      const saved = localStorage.getItem('hoopmap_current_session');
      if (saved) {
        try {
          currentUser = JSON.parse(saved);
          updateUserUI();
        } catch(e){}
      }
    }

    function updateUserUI() {
      if (currentUser) {
        document.getElementById('btn-login-header').classList.add('hidden');
        document.getElementById('user-header-profile').classList.remove('hidden');
        document.getElementById('user-header-name').innerText = currentUser.name;
        document.getElementById('user-header-avatar').src = currentUser.avatar;
      } else {
        document.getElementById('btn-login-header').classList.remove('hidden');
        document.getElementById('user-header-profile').classList.add('hidden');
      }
    }

    function handleLogout() {
      currentUser = null;
      localStorage.removeItem('hoopmap_current_session');
      updateUserUI();
    }

    /* ==========================================================================
       CREATE NEW COURT
       ========================================================================== */
    function handleCreateCourt(e) {
      e.preventDefault();
      const name = document.getElementById('new-court-name').value;
      const city = document.getElementById('new-court-city').value;
      const type = document.getElementById('new-court-type').value;
      const lat = parseFloat(document.getElementById('new-court-lat').value);
      const lng = parseFloat(document.getElementById('new-court-lng').value);
      const condition = document.getElementById('new-court-condition').value;

      const newCourt = {
        id: 'court_' + Date.now(),
        name: name,
        city: city,
        type: type,
        lat: lat,
        lng: lng,
        condition: condition || "Tableros reglamentarios",
        rating: 5.0,
        activePlayersToday: 1
      };

      courtsData.unshift(newCourt);
      saveStateToStorage();
      renderCourtsList(courtsData);
      updateMapMarkers(courtsData);

      document.getElementById('add-court-form').reset();
      switchTab('courts');
      alert('¡Cancha agregada exitosamente al mapa!');
    }

    /* ==========================================================================
       LIVE COURT CHAT SYSTEM
       ========================================================================== */
    function openCourtChat(courtId) {
      currentChatCourtId = courtId;
      const court = courtsData.find(c => c.id === courtId);
      
      document.getElementById('chat-court-title').innerText = court ? court.name : 'Chat de la Cancha';
      document.getElementById('chat-court-subtitle').innerText = court ? `${court.city} • ${court.type}` : '';
      
      document.getElementById('modal-court-chat').classList.remove('hidden');

      if (!currentUser) {
        document.getElementById('chat-input-area').classList.add('hidden');
        document.getElementById('chat-login-prompt').classList.remove('hidden');
      } else {
        document.getElementById('chat-input-area').classList.remove('hidden');
        document.getElementById('chat-login-prompt').classList.add('hidden');
      }

      renderChatMessages();
    }

    function closeChatModal() {
      document.getElementById('modal-court-chat').classList.add('hidden');
      currentChatCourtId = null;
    }

    function renderChatMessages() {
      const box = document.getElementById('chat-messages-box');
      box.innerHTML = '';

      const messages = courtChatMessages[currentChatCourtId] || [];

      if (messages.length === 0) {
        box.innerHTML = `
          <div class="text-center py-10 text-slate-500 text-xs">
            <i class="fa-solid fa-comments text-3xl mb-2"></i>
            <p>Aún no hay mensajes en esta cancha.</p>
            <p class="text-slate-600 mt-1">¡Escribe para armar la retia!</p>
          </div>
        `;
        return;
      }

      messages.forEach(msg => {
        const isMe = currentUser && currentUser.id === msg.userId;
        const div = document.createElement('div');
        div.className = `flex items-start space-x-2.5 ${isMe ? 'flex-row-reverse space-x-reverse' : ''}`;
        
        div.innerHTML = `
          <img src="${msg.userAvatar}" class="w-8 h-8 rounded-full object-cover border border-orange-500" alt="Avatar">
          <div class="max-w-[75%]">
            <div class="flex items-center space-x-2 ${isMe ? 'justify-end' : ''}">
              <span class="text-[11px] font-bold text-slate-300">${msg.userName}</span>
              <span class="text-[9px] text-slate-500">${msg.time}</span>
            </div>
            <div class="mt-1 p-3 rounded-2xl text-xs ${isMe ? 'bg-orange-500 text-white rounded-tr-none' : 'bg-slate-800 text-slate-200 rounded-tl-none border border-slate-700/60'}">
              ${msg.text}
            </div>
          </div>
        `;
        box.appendChild(div);
      });

      box.scrollTop = box.scrollHeight;
    }

    function handleChatKeyPress(e) {
      if (e.key === 'Enter') {
        sendChatMessage();
      }
    }

    function sendChatMessage() {
      if (!currentUser) return;
      const input = document.getElementById('chat-message-input');
      const text = input.value.trim();

      if (!text || !currentChatCourtId) return;

      if (!courtChatMessages[currentChatCourtId]) {
        courtChatMessages[currentChatCourtId] = [];
      }

      const now = new Date();
      const timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');

      const newMsg = {
        id: 'msg_' + Date.now(),
        userId: currentUser.id,
        userName: currentUser.name,
        userAvatar: currentUser.avatar,
        text: text,
        time: timeStr
      };

      courtChatMessages[currentChatCourtId].push(newMsg);
      saveStateToStorage();
      
      input.value = '';
      renderChatMessages();
    }
  </script>
</body>
</html>
